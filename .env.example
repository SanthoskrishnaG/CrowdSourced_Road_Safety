# ==============================================================================
# Environment Configuration Template
# Duplicate this file to '.env' and adjust parameters for your deployment.
# ==============================================================================

# Core Environment: development | testing | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security Secret Key (Generate a 64+ char random string in production)
# Example: openssl rand -hex 32
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/road_safety

# Static Evidence & Upload Storage Directory
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Allowed Origins (JSON array format or "*" for all)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000"]

# API Request Rate Limiter (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Multi-Factor Duplicate Detection Thresholds & Weights
DUPLICATE_DISTANCE_THRESHOLD_METERS=50.0
DUPLICATE_SCORE_THRESHOLD=0.65
WEIGHT_LOCATION=0.40
WEIGHT_CATEGORY=0.30
WEIGHT_TIME=0.15
WEIGHT_IMAGE=0.15

# Email & Notification Provider Configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=notifications@roadsafety.gov
SMTP_FROM_NAME="Road Infrastructure Platform"
